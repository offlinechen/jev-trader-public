# 复制为 .env；切勿提交真实 .env。 / Copy to .env; never commit the real file.
JEV_API_KEY=<your-openrouter-api-key>
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL_ID=~typesafe/jev-latest
JEV_PROMPT_VERSION=v3

